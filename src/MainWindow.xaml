<Window x:Class="ReeFont.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="REE Font Tool" Width="1100" Height="720" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="Black" Foreground="#00A5B1" WindowStyle="None" ResizeMode="CanResize" Icon="/icon.png" FontFamily="Segoe UI" FontSize="15">
<WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome><Window.Resources>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="#061214"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#237E86" Width="2" Margin="0,4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="Button"><Setter Property="Foreground" Value="#00A5B1"/><Setter Property="Background" Value="#0C1A1C"/><Setter Property="BorderBrush" Value="#164448"/><Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#17383B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#061214"/><Setter Property="Foreground" Value="#00A5B1"/><Setter Property="BorderBrush" Value="#164448"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="12,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid><ScrollViewer x:Name="PART_ContentHost"/><TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#527D81" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#00A5B1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border Width="20" Height="20" BorderBrush="#00A5B1" BorderThickness="1" Margin="0,0,16,0"><Border x:Name="Tick" Margin="4" Background="Transparent"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Background" Value="#00A5B1"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14,16"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#0C1A1C"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#10272A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="9,8"/><Setter Property="Margin" Value="3,0"/><Setter Property="Background" Value="Black"/><Setter Property="BorderBrush" Value="Black"/></Style></Window.Resources>
<Grid Margin="28,20,28,18">
<Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="25"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
<Grid MouseLeftButtonDown="Drag"><StackPanel Orientation="Horizontal"><Image Source="/icon.png" Width="44" Height="44"/><TextBlock Text="REE Font Tool" FontSize="27" FontWeight="Light" Margin="20,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource HeaderButton}" x:Name="LanguageButton" Content="中文" Click="ToggleLanguage" Background="Black" BorderBrush="Black"/><Button Style="{StaticResource HeaderButton}" Content="GitHub ↗" Click="GitHub"/><Button Style="{StaticResource HeaderButton}" Content="REFramework ↗" FontSize="16" Click="FrameworkHelp" Background="Black" BorderBrush="Black"/><Button Style="{StaticResource HeaderButton}" Content="−" Click="Minimize" Background="Black" BorderBrush="Black"/><Button Style="{StaticResource HeaderButton}" Content="□" Click="Maximize" Background="Black" BorderBrush="Black"/><Button Style="{StaticResource HeaderButton}" Content="×" Click="Exit" Background="Black" BorderBrush="Black"/></StackPanel></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="SearchBox" Tag="Search games…" TextChanged="SearchChanged"/><TextBlock x:Name="NoResults" Grid.Row="2" Text="No matching games" Foreground="#527D81" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/><ListBox Grid.Row="2" x:Name="Games" Background="#061214" Foreground="#00A5B1" BorderBrush="#164448" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="GameChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="15" FontWeight="Light"/><TextBlock Text="{Binding Zh}" Margin="0,8,0,0" FontSize="16"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="74"/><RowDefinition Height="74"/><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Height="50" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock x:Name="DirectoryLabel" Text="Game Directory :" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/><TextBox Tag="Select the game folder…" x:Name="DirectoryBox" Grid.Column="1" IsReadOnly="True" FontSize="15"/><Button x:Name="BrowseDirectory" Grid.Column="3" Content="Browse..." Foreground="White" Click="SelectDirectory"/></Grid>
<Grid Grid.Row="1" Height="50" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock x:Name="FontLabel" Text="Font File:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/><TextBox Tag="Select a TTF / OTF font…" x:Name="FontBox" Grid.Column="1" IsReadOnly="True" FontSize="15" ToolTip="TTF / OTF"/><Button x:Name="BrowseFont" Grid.Column="3" Content="Browse..." Foreground="White" Click="SelectFont"/></Grid>
<UniformGrid Grid.Row="2" Rows="1"><CheckBox x:Name="SC" Content="Simplified Chinese" IsChecked="True"/><CheckBox x:Name="TC" Content="Traditional Chinese"/><CheckBox x:Name="EN" Content="English"/></UniformGrid>
<Grid Grid.Row="3"><StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,12,0,0"><Button x:Name="ReplaceButton" Content="Replace" Width="145" Height="48" FontSize="19" Click="Replace"/><Button x:Name="RestoreButton" Content="Restore" Width="145" Height="48" FontSize="19" Margin="18,0,0,0" Background="Black" BorderBrush="Black" Click="Restore"/></StackPanel><Button x:Name="ExportButton" Content="Export ZIP" Click="ExportMod" HorizontalAlignment="Right" VerticalAlignment="Top" Height="48" Margin="0,12,0,0" FontSize="15.2" Padding="0"><Button.Template><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button></Grid>
<TextBox Tag="Replacement and restore activity…" x:Name="LogBox" VerticalContentAlignment="Top" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15" Padding="25,20"/>
</Grid></Grid>
<TextBlock x:Name="Status" Grid.Row="3" Text="Ready" Foreground="#00C75A" VerticalAlignment="Bottom" FontSize="18"/><TextBlock Grid.Row="3" Text="v1.3" Foreground="#444444" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
</Grid>
</Window>






